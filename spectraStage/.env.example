# Public origin of the app (used for WebSocket Origin checks). Leave empty to allow any origin (dev only).
PUBLIC_URL=https://spectrastage.example.com
PORT=3000
HOST=0.0.0.0
# Trust X-Forwarded-* headers from the reverse proxy (Easypanel/Traefik, Nginx, Caddy)
TRUST_PROXY=true
# Use Cloudflare's CF-Connecting-IP header as client IP for rate limits (only if behind Cloudflare!)
CLOUDFLARE=true
DATABASE_PATH=/data/spectrastage.db
# 0 = shows never expire
SESSION_TTL_DAYS=0
MAX_SESSIONS=20000
MAX_DEVICES_PER_SESSION=16
PAIRING_CODE_TTL_MINUTES=15
LOG_LEVEL=info
